# Copy to .env and adjust. Every app validates its variables at startup and fails with a clear
# message when one is missing or invalid. docker-compose.yml and `npm run dev` read the same names.

# --- General ---
NODE_ENV=development
# pino level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# --- Postgres (job-service only; job-execution-service has no database access) ---
POSTGRES_USER=jobqueue
POSTGRES_PASSWORD=jobqueue
POSTGRES_DB=jobqueue
POSTGRES_PORT=5432
DATABASE_URL=postgresql://jobqueue:jobqueue@localhost:5432/jobqueue

# --- Redis (queue store) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- job-service ---
JOB_SERVICE_PORT=3000
# Largest request body in bytes on every route, a bulk submission included (optional, default
# 1048576); larger bodies get 413 PAYLOAD_TOO_LARGE
# JOB_SERVICE_BODY_LIMIT_BYTES=1048576
# Job query page size without `limit` (optional, default 20) and the largest `limit` allowed
# (optional, default 100); a larger `limit` gets 400 VALIDATION_FAILED
# JOB_SERVICE_QUERY_DEFAULT_LIMIT=20
# JOB_SERVICE_QUERY_MAX_LIMIT=100
# How long putting a job on the queue may take in ms (optional, default 2000); after that the job
# stays pending
# JOB_SERVICE_ENQUEUE_TIMEOUT_MS=2000
# Most jobs in one bulk submission (optional, default 100); more get 400 VALIDATION_FAILED
# JOB_SERVICE_BULK_MAX_JOBS=100

# --- Internal API (job-service <-> job-execution-service) ---
# Shared service token for /internal routes. Use a long random value outside local development.
INTERNAL_SERVICE_TOKEN=change-me-local-dev-token

# --- job-execution-service ---
# Port of its own HTTP server (GET /health)
JOB_EXECUTION_SERVICE_PORT=3001
# job-service's base URL for the internal API (compose uses http://job-service:3000)
JOB_SERVICE_URL=http://localhost:3000
# Jobs one instance runs at the same time (optional, default 5)
# JOB_EXECUTION_CONCURRENCY=5
# Simulated email send time in ms, uniform in [min, max] (optional, defaults 1000 and 3000)
# EMAIL_SEND_MIN_MS=1000
# EMAIL_SEND_MAX_MS=3000
# Simulated webhook call time in ms, and the share of webhook attempts that fail with a random 5xx,
# from 0 (never) to 1 (always) (optional, defaults 1500 and 0.2)
# WEBHOOK_CALL_MS=1500
# WEBHOOK_FAILURE_RATE=0.2
# Simulated flight transit report generation time in ms, and the share of transit attempts that
# fail with FLIGHT_TRANSIT_DATA_UNAVAILABLE, from 0 (never) to 1 (always) (optional, defaults 2000
# and 0.1)
# FLIGHT_TRANSIT_GENERATE_MS=2000
# FLIGHT_TRANSIT_FAILURE_RATE=0.1
# Transit report shape: points on the great-circle path, cruise waypoints, the distance from which
# a wide-body flies, climb and descent distances in km, and the ground speed at the airports in
# km/h (optional, defaults 64, 4, 4000, 200, 250 and 30)
# FLIGHT_TRANSIT_PATH_POINTS=64
# FLIGHT_TRANSIT_CRUISE_WAYPOINTS=4
# FLIGHT_TRANSIT_LONG_HAUL_KM=4000
# FLIGHT_TRANSIT_CLIMB_KM=200
# FLIGHT_TRANSIT_DESCENT_KM=250
# FLIGHT_TRANSIT_TAXI_SPEED_KMH=30
# Tries again when a call to job-service fails; the wait before the first retry in ms, doubled
# (and randomized) on each retry up to the maximum (optional, defaults 3, 500 and 5000)
# JOB_REPORT_RETRIES=3
# JOB_REPORT_RETRY_DELAY_MS=500
# JOB_REPORT_RETRY_MAX_DELAY_MS=5000
# How long one call to job-service may take in ms (optional, default 5000)
# JOB_SERVICE_TIMEOUT_MS=5000
# How long a shutdown waits for running jobs in ms (optional, default 10000)
# JOB_EXECUTION_SHUTDOWN_GRACE_MS=10000

# --- job-ui ---
# Port of the nginx container in docker compose (the Vite dev server uses JOB_UI_DEV_PORT)
JOB_UI_PORT=8080
JOB_UI_DEV_PORT=5173
# Target of the /api proxy of the Vite dev server
JOB_UI_API_PROXY_TARGET=http://localhost:3000

{
  "name": "@job-queue/service-kit",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS pieces shared by the backend services: bootstrap, base config, logging, Redis and health",
  "type": "module",
  "exports": {
    ".": {
      "@job-queue/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests --project service-kit:integration"
  },
  "dependencies": {
    "@job-queue/contracts": "*",
    "@job-queue/kernel": "*",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^11.4.7",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.5.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@job-queue/test-support": "*",
    "@nestjs/testing": "^11.2.8",
    "@swc/core": "^1.16.20",
    "@testcontainers/redis": "^12.2.1",
    "pino-pretty": "^13.2.0",
    "testcontainers": "^12.2.1",
    "unplugin-swc": "^2.0.0"
  }
}

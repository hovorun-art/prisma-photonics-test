{
  "name": "@job-queue/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schemas and inferred types shared by job-service, job-execution-service and job-ui",
  "type": "module",
  "exports": {
    ".": {
      "@job-queue/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@job-queue/kernel": "*",
    "zod": "^4.6.7"
  }
}

{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "NestJS apps: CommonJS output with decorator metadata for dependency injection",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  }
}

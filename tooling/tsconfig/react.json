{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "React + Vite app: bundler resolution, DOM types, no emit (Vite builds)",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["vite/client"]
  }
}

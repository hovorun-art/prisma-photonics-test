{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Shared packages: framework-free ESM libraries consumed by the apps",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true
  }
}

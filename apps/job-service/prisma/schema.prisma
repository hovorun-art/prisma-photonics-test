// job-service owns the database: no other service connects to it (design.md, "Repository layout").
// Job state lives here; job-execution-service changes it only through the internal API.

generator client {
  provider     = "prisma-client"
  output       = "../src/infra/prisma/generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum JobType {
  email
  webhook
  /// `flight-transit` in the API and in Postgres; Prisma enum names cannot contain `-`.
  flight_transit @map("flight-transit")

  @@map("job_type")
}

enum JobStatus {
  scheduled
  pending
  processing
  completed
  failed
  cancelled

  @@map("job_status")
}

/// A background job; job-service is the only writer. Timestamps keep milliseconds, like the API.
model Job {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        JobType
  payload     Json
  status      JobStatus
  /// Higher is more urgent.
  priority    Int
  /// Attempts started so far; counted when an attempt starts.
  attempts    Int
  maxAttempts Int       @map("max_attempts")
  /// 1, plus one per manual retry; queue entry ids carry it, since a retry starts attempts again at 1.
  run         Int       @default(1)
  result      Json?
  error       Json?
  /// The group the job was submitted in, as the client gave it; no meaning to job-service.
  groupId     String?   @map("group_id") @db.Uuid
  scheduledAt DateTime? @map("scheduled_at") @db.Timestamptz(3)
  startedAt   DateTime? @map("started_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// The query's order (newest first, id breaks ties so offset paging is stable).
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "jobs_created_at_id_idx")
  /// Status filters and the sweep of pending jobs.
  @@index([status, createdAt(sort: Desc)], map: "jobs_status_created_at_idx")
  /// Type filters.
  @@index([type, createdAt(sort: Desc)], map: "jobs_type_created_at_idx")
  /// Group filters (a group's jobs, polled by job-group-service).
  @@index([groupId, createdAt(sort: Desc)], map: "jobs_group_id_created_at_idx")
  /// The statistics' counts of jobs finished within a window.
  @@index([status, completedAt], map: "jobs_status_completed_at_idx")
  @@map("jobs")
}
